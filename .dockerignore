# 只把构建需要的文件送进 docker build 上下文
.git
.gitignore
.ruff_cache
.pytest_cache

# Python 虚拟环境与缓存
.venv
__pycache__
*.py[cod]

# 运行期数据 / 凭据（绝不进镜像）
.env
.env.*
!.env.example
config.yaml
*.local.yaml
cookies/
auth.db
auth.db-*
*qxid-*.json
certs/
*.pem
*.key

# 业务数据与历史抓包
orders.csv
data/
old_data/
archive/
exports/
output/
build/
dist/

# 本地临时目录与文档
.scratch/
tmp/
temp/
*.log
logs/

# 测试不参与运行镜像（要跑测试请在宿主或 CI 里跑）
tests/
packaging/
scripts/
