# erp-tools docker 部署只需要这几个值（应用配置在 config.yaml，由 scripts/up.sh 生成）
# 复制成仓库根目录的 .env：cp docker/env.example .env

# 授权后的对外地址（nginx 的 host:port，也是证书 SAN 与 Host 白名单来源）
ERP_PUBLIC_HOST=erp-tools.lan:8443

# PostgreSQL 密码（只用 URL 安全字符；会写进生成的 config.yaml）
POSTGRES_PASSWORD=change-me

# 上游 ERP 主站
ERP_HOST=http://192.168.1.199:8889

# 可选：第一个管理员用户名（注册同名账号即自动获得 admin 角色）
# ERP_ADMIN_USER=root
