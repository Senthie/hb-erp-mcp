# ⚠ 旧版配置方式：仍兼容，但推荐用 config.yaml（见 packaging/config.example.yaml）
# 优先级：命令行 > 真实环境变量 > config.yaml > 本文件
#
# ── ERP 连接 ───────────────────────────────────────────────
# 内网：http://192.168.1.199:8889    外网：http://14.12.0.172:8889
ERP_HOST=http://192.168.1.199:8889
# 验证码服务在**另一个端口**；留空则自动把 ERP_HOST 的端口换成 8887
ERP_CAPTCHA_HOST=

# ── 账号 ──────────────────────────────────────────────────
# 只给 **CLI 自己用**（erp login / query / attendance 直接连 ERP）。
# 服务端模式（erp serve）**完全不读这两个变量**：每个使用者调
# POST /v1/auth/login（或 `erp key --server ...`）用自己的工号密码换 api-key，
# 密码只在一次请求的调用栈里存在，既不落盘也不进容器。
# → 部署 Docker / 团队网关时，请把 ERP_USERNAME、ERP_PASSWORD 从这里删掉。
ERP_USERNAME=21146
ERP_PASSWORD=

# ── 权限号（QXID）─────────────────────────────────────────
# 留空则登录后从菜单自动探测；探测结果缓存在 COOKIE_DIR/qxid-<user>.json
ERP_QXID_QUOTE=
# 列表页 Index.aspx（查询/导出用），实测 876
ERP_QXID_QUOTE_INDEX=
ERP_QXID_ATTENDANCE=

# ── 运行参数 ──────────────────────────────────────────────
# 实测该 ERP 约 4~8 并发即饱和，调大只会让单请求变慢
ERP_MAX_CONCURRENCY=8
# 全局最小请求间隔（秒）
ERP_REQUEST_DELAY=0.0
ERP_TIMEOUT_CONNECT=10
ERP_TIMEOUT_READ=60

# ── 存储 ──────────────────────────────────────────────────
COOKIE_DIR=./cookies
# ── 服务端模式（erp serve / erp-mcp）───────────────────
# 监听地址；非回环地址必须同时配 TLS 与 ERPSRV_ALLOW_HOST，否则拒绝启动
ERPSRV_BIND=127.0.0.1:8765
# api-key 库（sqlite）；留空则用 <数据目录>/auth.db
ERPSRV_DB=
# 全局 ERP 并发上限（实测 4~8 饱和）
ERPSRV_CONCURRENCY=6
# 团队模式必填
ERPSRV_TLS_CERT=
ERPSRV_TLS_KEY=
# 团队模式必填，逗号分隔，如 erp-tools.lan:8765
ERPSRV_ALLOW_HOST=
# 放在反向代理后面时才打开
ERPSRV_TRUST_PROXY=false
# 显式允许「非回环 + 明文 HTTP」：只给 TLS 由上游代理（docker + nginx）终止的场景用
ERPSRV_ALLOW_PLAINTEXT=false

# ── Docker Compose 专用（仅 docker-compose.yml 读取）──────
# 对外访问地址：必须与客户端实际用的 host:port 一致（nginx 用 $http_host 透传后逐字比对）
# ERP_PUBLIC_HOST=erp-tools.lan:8443
# ERP_HTTPS_PORT=8443
# ERP_HTTP_PORT=8080
# 想用纯 HTTP 内网版：NGINX_CONF=docker/nginx-http.conf