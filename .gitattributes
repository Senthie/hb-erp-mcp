# 统一行尾：仓库里一律存 LF，避免 Windows 上 `core.autocrlf=false` 时
# 把 CRLF 提交进去 —— 那样服务器上的 shell 脚本会报 `/bin/bash^M: bad interpreter`。
* text=auto

*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.ps1        text eol=crlf
